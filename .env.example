# Auth.js — generate with: openssl rand -base64 33
AUTH_SECRET=
# Public base URL. Set explicitly so Auth.js does not build redirect_uri from
# proxy headers (Zitadel would answer with redirect_uri mismatch).
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Zitadel OIDC — values from `tofu output -raw wellbeing_client_id|_secret`
AUTH_ZITADEL_ID=
AUTH_ZITADEL_SECRET=
AUTH_ZITADEL_ISSUER=https://zitadel.int.buse.io
ZITADEL_ORG_ID=374196986292732223
WELLBEING_REQUIRED_ROLE=wellbeing-user

DATABASE_URL=postgres://wellbeing:wellbeing@localhost:5432/wellbeing

# Open Food Facts requires an identifying User-Agent: AppName/Version (contact)
OFF_USER_AGENT=Wellbeing/1.0 (maik.buse@sicore.de)

TZ=Europe/Berlin
